{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "timeseries",
      "title": "Pipeline Stage Duration P95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(pipeline_stage_duration_bucket[5m])) by (le, stage))",
          "legendFormat": "{{stage}}"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Submission Failure Rate",
      "targets": [
        {
          "expr": "sum(rate(pipeline_stage_failures_total[5m])) / sum(rate(pipeline_stage_processed_total[5m]))",
          "legendFormat": "failure-rate"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "Asset Size Distribution",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(upload_asset_size_bucket[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(upload_asset_size_bucket[5m])) by (le))",
          "legendFormat": "P95"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 }
    }
  ],
  "schemaVersion": 38,
  "version": 1,
  "title": "AutoMark Pipeline"
}
